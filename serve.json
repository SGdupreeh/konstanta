{
  "cleanUrls": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/solutions", "destination": "/solutions.html" },
    { "source": "/documents", "destination": "/documents.html" },
    { "source": "/contacts", "destination": "/contacts.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "redirects": [
    { "source": "/schools.html", "destination": "/projects.html" },
    { "source": "/production.html", "destination": "/solutions.html" },
    { "source": "/about.html", "destination": "/index.html" },
    { "source": "/project-school-01.html", "destination": "/projects.html" },
    { "source": "/project-school-02.html", "destination": "/projects.html" },
    { "source": "/project-school-03.html", "destination": "/projects.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|png|webp|avif|gif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "**/*.@(woff|woff2|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "**/*.@(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
